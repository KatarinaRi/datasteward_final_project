cenvo:activity_identifier a owl:DatatypeProperty ;
    rdfs:label "activity_identifier" ;
    skos:definition "Project/monitoring programme identifier provided as URL (GUPRI). At least one identifier required." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:campaigns a owl:ObjectProperty ;
    rdfs:label "campaigns" ;
    skos:definition "If an Environmental Monitoring Programme/Project has a long-term perspective of at least  a few years, it may be necessary to input data at suitable time intervals. For this time period,  is used the term \"Campaign\". A Campaign is defined by its start and end, and it is recommended  to name it within the project using a consistent style." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:compartment a owl:ObjectProperty ;
    rdfs:label "compartment" ;
    skos:definition "The environmental compartment where the organism was sampled from." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:contacts a owl:ObjectProperty ;
    rdfs:label "contacts" ;
    skos:definition "Contact person(s) for the monitoring activity." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:funders a owl:ObjectProperty ;
    rdfs:label "funders" ;
    skos:definition "Funding entity/entities supporting the monitoring activity." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:institutions a owl:ObjectProperty ;
    rdfs:label "institutions" ;
    skos:definition "Institution(s) responsible for implementing the monitoring activity." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:language a owl:ObjectProperty ;
    rdfs:label "language" ;
    skos:definition "Language(s) used, as 2-letter codes according to ISO 639-1." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:observations a owl:ObjectProperty ;
    rdfs:label "observations" ;
    skos:definition "Observations (concentration measurements and parameters) associated with this sample." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:samples a owl:ObjectProperty ;
    rdfs:label "samples" ;
    skos:definition "Samples collected at this monitoring site." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:sites a owl:ObjectProperty ;
    rdfs:label "sites" ;
    skos:definition "Monitoring site(s) associated with this project or monitoring programme." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

