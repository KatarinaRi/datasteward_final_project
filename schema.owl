[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty cenvo:latitude ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty cenvo:longitude ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty cenvo:coordinate_privacy_exception ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "false" ] ) ] ] cenvo:Site ) .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:Sample ;
    owl:onProperty cenvo:domain ;
    owl:someValuesFrom cenvo:Sample .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:Terrestrial ;
    owl:onProperty cenvo:domain ;
    owl:someValuesFrom cenvo:Terrestrial .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:MeasurementParameter ;
    owl:onProperty cenvo:observation_type ;
    owl:someValuesFrom cenvo:MeasurementParameter .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:Atmospheric ;
    owl:onProperty cenvo:domain ;
    owl:someValuesFrom cenvo:Atmospheric .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cenvo:value ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ owl:intersectionOf ( [ a owl:Restriction ;
                            owl:onProperty cenvo:lod ;
                            owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                            owl:onProperty cenvo:loq ;
                            owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                            owl:onProperty cenvo:value ;
                            owl:someValuesFrom xsd:string ] ) ] cenvo:MeasurementConcentration ) .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:Observation ;
    owl:onProperty cenvo:observation_type ;
    owl:someValuesFrom cenvo:Observation .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cenvo:monitoring_reasons ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty cenvo:type ;
                owl:someValuesFrom xsd:string ] cenvo:MonitoringActivity ) .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:Aquatic ;
    owl:onProperty cenvo:domain ;
    owl:someValuesFrom cenvo:Aquatic .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:MeasurementConcentration ;
    owl:onProperty cenvo:observation_type ;
    owl:someValuesFrom cenvo:MeasurementConcentration .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cenvo:legislation_policy ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty cenvo:type ;
                owl:someValuesFrom xsd:string ] cenvo:MonitoringActivity ) .

[] a owl:Restriction ;
    rdfs:subClassOf cenvo:Biota ;
    owl:onProperty cenvo:domain ;
    owl:someValuesFrom cenvo:Biota .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty cenvo:coordinate_privacy_exception_reason ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty cenvo:country ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty cenvo:geographic_region ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty cenvo:nuts3 ;
                        owl:someValuesFrom xsd:string ] [ a owl:Restriction ;
                        owl:onProperty cenvo:regional_group ;
                        owl:someValuesFrom xsd:string ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty cenvo:coordinate_privacy_exception ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "true" ] ) ] ] cenvo:Site ) .


