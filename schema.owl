@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ns1: <http://open-services.net/ns/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/chemical-exposome/schema/chemicals-outdoor.owl.ttl> a owl:Ontology ;
    rdfs:label "chemicals-outdoor-schema" ;
    ns1:modifiedBy <https://orcid.org/0000-0003-0222-801x> ;
    dcterms:contributor <https://orcid.org/XXXX-XXXX-XXXX-XXXX> ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:title "Metadata Schema for Data Concerning Chemicals in the Outdoor Environment" ;
    pav:createdBy <https://orcid.org/0000-0003-0222-801x> ;
    pav:createdOn "2026-06-08T00:00:00+00:00" ;
    pav:lastUpdatedOn "2026-07-26T00:00:00+00:00" ;
    pav:version "1.1.0" ;
    rdfs:seeAlso <https://doi.org/10.5281/zenodo.17175075>,
        <https://www.parc-project.eu> ;
    skos:definition "This metadata schema represents the minimum metadata community standard for reporting data concerning  the occurrence of chemicals in the outdoor environment (environmental monitoring data) as discussed and agreed upon  by the European Partnership for the Assessment of Risks from Chemicals. The schema contains metadata elements and associated codelists to describe a project or monitoring programme that generated the data, elements to describe the monitoring site, sample,  concentration and other parameters, and the associated codelists. Atmospheric, terrestrial, and aquatic environments,  as well as in biota, are covered." ;
    skos:note "CRediT contributor roles (https://credit.niso.org/contributor-roles/): Conceptualization: [Name] (https://orcid.org/XXXX-XXXX-XXXX-XXXX); Data curation: [Name] (https://orcid.org/XXXX-XXXX-XXXX-XXXX); Methodology: [Name], [Name] (https://orcid.org/XXXX-XXXX-XXXX-XXXX); Software: [Name] (https://orcid.org/XXXX-XXXX-XXXX-XXXX); Validation: [Name] (https://orcid.org/XXXX-XXXX-XXXX-XXXX); Writing - original draft: [Name] (https://orcid.org/XXXX-XXXX-XXXX-XXXX)" ;
    cenvo:changelog "https://github.com/269713/datasteward_final_project/blob/main/CHANGELOG.md" ;
    cenvo:contributor_conceptualization "https://orcid.org/XXXX-XXXX-XXXX-XXXX" ;
    cenvo:contributor_data_curation "https://orcid.org/XXXX-XXXX-XXXX-XXXX" ;
    cenvo:contributor_methodology "https://orcid.org/XXXX-XXXX-XXXX-XXXX https://orcid.org/XXXX-XXXX-XXXX-XXXX" ;
    cenvo:contributor_software "https://orcid.org/XXXX-XXXX-XXXX-XXXX" ;
    cenvo:contributor_validation "https://orcid.org/XXXX-XXXX-XXXX-XXXX" ;
    cenvo:contributor_writing_original_draft "https://orcid.org/XXXX-XXXX-XXXX-XXXX" ;
    cenvo:credit_ontology "https://credit.niso.org/contributor-roles/" ;
    cenvo:funding "This work was supported by the European Partnership for the Assessment of Risks from Chemicals (PARC), funded by the European Union under Horizon Europe grant agreement No 101057014." ;
    cenvo:latest_editors_draft "https://github.com/269713/datasteward_final_project/blob/main/part1-for-validation.yml" ;
    cenvo:latest_published_version "https://w3id.org/chemical-exposome/schema/chemicals-outdoor/1.0.0" ;
    cenvo:schema_status "draft" ;
    cenvo:this_version "https://w3id.org/chemical-exposome/schema/chemicals-outdoor/1.1.0" .

<http://www.opengis.net/def/crs/EPSG/0/4326> a owl:Class ;
    rdfs:label "WGS84" ;
    rdfs:subClassOf cenvo:CoordinateSystem ;
    skos:definition "World Geodetic System 1984. Global coordinate system widely used for GPS navigation." .

xsd:gYear a rdfs:Datatype .

<https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AnalyticalMethod#PLACEHOLDER> a owl:Class ;
    rdfs:label "PLACEHOLDER" ;
    rdfs:subClassOf cenvo:AnalyticalMethod ;
    skos:definition "Placeholder value — final vocabulary pending. Do not use in production data." .

cenvo:Campaign a owl:Class ;
    rdfs:label "Campaign" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:campaign_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:end_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:acronym ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:name_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cenvo:start_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:acronym ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:name_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:campaign_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:campaign_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:acronym ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cenvo:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:name_en ] ;
    skos:definition "A time-bounded data collection period within a project or monitoring programme. Mandatory if the campaign exists." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:ChemicalCompound a owl:Class ;
    rdfs:label "ChemicalCompound" ;
    rdfs:seeAlso <https://doi.org/10.1186/s13321-025-01092-3> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:compound_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d{2,7}-\\d{2}-\\d$" ] ) ] ) ] ;
            owl:onProperty cenvo:cas_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:cas_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cenvo:wp9_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:chebi_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:pubchem_cid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cenvo:pubchem_cid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:norman_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:inchikey ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:ec_number ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:compound_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cenvo:chebi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:wp9_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:CompoundGroup ;
            owl:onProperty cenvo:compound_group ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:compound_group ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[A-Z]{14}-[A-Z]{10}-[A-Z]$" ] ) ] ) ] ;
            owl:onProperty cenvo:inchikey ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:norman_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:cas_number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:pubchem_cid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:chebi_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:norman_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:compound_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:inchikey ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^InChI=1S/" ] ) ] ) ] ;
            owl:onProperty cenvo:inchi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:compound_group ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:ec_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:inchi ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^\\d{3}-\\d{3}-\\d$" ] ) ] ) ] ;
            owl:onProperty cenvo:ec_number ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:inchi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:wp9_id ] ;
    skos:definition "A chemical compound monitored in environmental samples. The compound list (1500+ substances) was developed in PARC WP9 in collaboration with other WPs. Each compound is identified by multiple persistent identifiers and assigned to a compound group. See: https://doi.org/10.5281/zenodo.17175075" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Contact a owl:Class ;
    rdfs:label "Contact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:email ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:contact_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:orcid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:orcid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Role ;
            owl:onProperty cenvo:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:orcid ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:contact_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Institution ;
            owl:onProperty cenvo:institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:email ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:contact_id ] ;
    skos:definition "A contact person associated with the monitoring activity." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Funder a owl:Class ;
    rdfs:label "Funder" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:funder_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:funder_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:funder_id ],
        cenvo:OrganisationMetadata ;
    skos:definition "Funder" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

<https://w3id.org/chemical-exposome/schema/chemicals-outdoor/SamplingMethodAquatic#PLACEHOLDER> a owl:Class ;
    rdfs:label "PLACEHOLDER" ;
    rdfs:subClassOf cenvo:SamplingMethodAquatic ;
    skos:definition "Placeholder — do not use in production." .

<https://w3id.org/chemical-exposome/schema/chemicals-outdoor/SamplingMethodAtmospheric#PLACEHOLDER> a owl:Class ;
    rdfs:label "PLACEHOLDER" ;
    rdfs:subClassOf cenvo:SamplingMethodAtmospheric ;
    skos:definition "Placeholder — do not use in production." .

cenvo:Taxon a owl:Class ;
    rdfs:label "Taxon" ;
    rdfs:seeAlso <https://www.gbif.org/species/search> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:taxon_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cenvo:taxon_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:taxon_rank ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:taxon_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:taxon_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:taxon_rank ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:taxon_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:taxon_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:TaxonRankEnum ;
            owl:onProperty cenvo:taxon_rank ] ;
    skos:definition "A taxonomic entity identified in a biological sample, referenced against the GBIF Backbone Taxonomy." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

