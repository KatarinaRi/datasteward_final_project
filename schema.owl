cenvo:Aquatic a owl:Class ;
    rdfs:label "Aquatic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cenvo:AquaticMatrixFraction ;
            owl:onProperty cenvo:fraction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:MatrixAquatic ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:SamplingMethodAquatic ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:fraction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:fraction ],
        cenvo:Sample ;
    skos:definition "Aquatic sample" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Atmospheric a owl:Class ;
    rdfs:label "Atmospheric" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cenvo:SamplingMethodAtmospheric ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:MatrixAtmospheric ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        cenvo:Sample ;
    skos:definition "Atmospheric sample" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Biota a owl:Class ;
    rdfs:label "Biota" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:gender ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:EnvironmentalCompartment ;
            owl:onProperty cenvo:compartment ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Gender ;
            owl:onProperty cenvo:gender ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Taxon ;
            owl:onProperty cenvo:taxonomic_classification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:taxonomic_classification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:taxonomic_classification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:compartment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:life_stage_age ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:life_stage_age ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:life_stage_age ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:MatrixBiota ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:gender ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:sampling_method ],
        cenvo:Sample ;
    skos:definition "Biota sample" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Institution a owl:Class ;
    rdfs:label "Institution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:institution_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:country ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Country ;
            owl:onProperty cenvo:country ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:institution_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:country ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:institution_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:acronym ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:acronym ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:acronym ],
        cenvo:OrganisationMetadata ;
    skos:definition "Institution" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:MeasurementParameter a owl:Class ;
    rdfs:label "MeasurementParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:parameter ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Parameter ;
            owl:onProperty cenvo:parameter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:parameter ],
        cenvo:Observation ;
    skos:definition "An additional parameter measured in the sample (e.g. pH, temperature, TOC). Depends on matrix type.  Gives context to the chemical concentration measurement." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:MonitoringActivityType a owl:Class ;
    rdfs:label "MonitoringActivityType" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/MonitoringActivityType#scientific_project> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/MonitoringActivityType#monitoring_programme> ) ;
    skos:definition "Type of monitoring activity" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/MonitoringActivityType#monitoring_programme>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/MonitoringActivityType#scientific_project> .

cenvo:ObservationType a owl:Class ;
    rdfs:label "ObservationType" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ObservationType#MeasurementConcentration> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ObservationType#MeasurementParameter> ) ;
    skos:definition "Type of measurement/observation: i) Chemical concentration in the environment or biota - main observation and; ii) Other parameters - they give context to the  main measurement." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ObservationType#MeasurementConcentration>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ObservationType#MeasurementParameter> .

cenvo:Site a owl:Class ;
    rdfs:label "Site" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:regional_group ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Sample ;
            owl:onProperty cenvo:samples ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:CoordinateSystem ;
            owl:onProperty cenvo:coordinate_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:WaterGeographicalFeature ;
            owl:onProperty cenvo:water_geographical_feature ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:site_id ],
