        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:water_treatment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:river_basin ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:site_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cenvo:link ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:year_established ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:water_treatment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:site_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:nuts3 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:soil_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:land_use ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:regional_group ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:site_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sea ] ;
    skos:definition "A monitoring site or location where samples are collected. Coordinates (latitude and longitude) are mandatory unless they cannot be provided for privacy, security or confidentiality reasons. When coordinates are provided, GIS-derived fields (NUTS3, land use, river basin, sea, soil type) can be automatically retrieved from GIS layers. When coordinates are not provided, expert-described location fields (country, geographic region, NUTS3) are required instead." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Terrestrial a owl:Class ;
    rdfs:label "Terrestrial" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:matrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:sampling_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:MatrixTerrestrial ;
            owl:onProperty cenvo:matrix ],
        cenvo:Sample ;
    skos:definition "A sample from the terrestrial domain (soil)" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:WaterTreatment a owl:Class ;
    rdfs:label "WaterTreatment" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/WaterTreatment#pre_treatment> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/WaterTreatment#post_treatment> ) ;
    skos:definition "Water treatment status" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/WaterTreatment#post_treatment>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/WaterTreatment#pre_treatment> .

cenvo:access_procedures a owl:DatatypeProperty ;
    rdfs:label "access_procedures" ;
    skos:definition "Information on procedure to obtain access to the dataset." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:acknowledgement a owl:DatatypeProperty ;
    rdfs:label "acknowledgement" ;
    skos:definition "Text for acknowledgement which should be reported when using/re-using the data." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:activity_description a owl:DatatypeProperty ;
    rdfs:label "activity_description" ;
    skos:definition "A brief summary with the most important details summarising the project (objectives, scope, target group, key aspects, design, methods)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:altitude a owl:DatatypeProperty ;
    rdfs:label "altitude" ;
    skos:definition "Altitude in meters above sea level (MSL). Use positive values for above and negative for below sea level." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:analysis_date a owl:DatatypeProperty ;
    rdfs:label "analysis_date" ;
    skos:definition "The date on which the concentration was determined" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:analytical_method a owl:ObjectProperty ;
    rdfs:label "analytical_method" ;
    skos:definition "Analytical method used to determine the analyte" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:analytical_method_link a owl:DatatypeProperty ;
    rdfs:label "analytical_method_link" ;
    skos:definition "GUPRI linking to a public SOP or document describing the method" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:batch a owl:DatatypeProperty ;
    rdfs:label "batch" ;
    skos:definition "Internal laboratory designation of the group of samples analyzed together" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:campaign_description a owl:DatatypeProperty ;
    rdfs:label "campaign_description" ;
    skos:definition "Description of the campaign" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:cas_number a owl:DatatypeProperty ;
    rdfs:label "cas_number" ;
    skos:definition "CAS Registry Number — unique numerical identifier assigned by the Chemical Abstracts Service. Format: NNNNNN-NN-N" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:chebi_id a owl:DatatypeProperty ;
    rdfs:label "chebi_id" ;
    skos:definition "ChEBI identifier for the compound. To be populated by mapping from InChIKey to ChEBI. Format: CHEBI:NNNNN" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:compound a owl:ObjectProperty ;
    rdfs:label "compound" ;
    skos:definition "Chemical compound measured in the sample. Reference to the PARC WP9 compound list entry (ChemicalCompound class). Identified by WP9_id, name, CAS, EC, InChI, and InChIKey. Mappable to ChEBI, PubChem, and NORMAN identifiers. A single measurement record should typically correspond to one compound." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:compound_group a owl:ObjectProperty ;
    rdfs:label "compound_group" ;
    skos:definition "Chemical group classification of the compound as defined in the PARC WP9 compound list (e.g. PFAS, biocides, PCBs, PAHs). # TODO: Future alignment planned with ChemFOnt functional classes # and/or C3PO (ChEBI Chemical Class Program Ontology)" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:compound_name a owl:DatatypeProperty ;
    rdfs:label "compound_name" ;
    skos:definition "Common or abbreviated name of the compound as used in the PARC community (e.g. PFOS, triclosan)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:contact_id a owl:DatatypeProperty ;
    rdfs:label "contact_id" ;
    skos:definition "Unique contact ID" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:coordinate_system a owl:ObjectProperty ;
    rdfs:label "coordinate_system" ;
    skos:definition "Coordinate reference system used. Default is EPSG:4326 (WGS 84)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:data_handling_procedure a owl:DatatypeProperty ;
    rdfs:label "data_handling_procedure" ;
    skos:definition "Description of steps taken after chemical analysis (e.g., blank correction, quality control, calibration, recovery, standardization, recalculations)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:data_handling_procedure_link a owl:DatatypeProperty ;
    rdfs:label "data_handling_procedure_link" ;
    skos:definition "GUPRI linking to a document describing the data handling procedure" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:disclaimer a owl:DatatypeProperty ;
    rdfs:label "disclaimer" ;
    skos:definition "Text for disclaimer when using/re-using the data." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:ec_number a owl:DatatypeProperty ;
    rdfs:label "ec_number" ;
    skos:definition "EC Number (European Community Number) — identifier used in the ECHA substance inventory (EINECS, ELINCS, NLP). Format: NNN-NNN-N" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:range xsd:string ;
    skos:definition "Email address of the project contact point. Institutional email is recommended." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:fraction a owl:ObjectProperty ;
    rdfs:label "fraction" ;
    skos:definition "If the collected sample is divided into multiple fractions for separate analysis, this field identifies each subsample." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:funder_id a owl:DatatypeProperty ;
    rdfs:label "funder_id" ;
    skos:definition "Unique funder ID" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:gender a owl:ObjectProperty ;
    rdfs:label "gender" ;
    skos:definition "Collected organism gender" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:implementation_level a owl:ObjectProperty ;
    rdfs:label "implementation_level" ;
    skos:definition "The geographic scale of the monitoring coverage (international, national, regional, or local)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:inchi a owl:DatatypeProperty ;
    rdfs:label "inchi" ;
    skos:definition "IUPAC International Chemical Identifier (InChI) — a standard textual representation of the molecular structure. Begins with 'InChI=1S/'." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:inchikey a owl:DatatypeProperty ;
    rdfs:label "inchikey" ;
    skos:definition "InChIKey — a fixed-length (27-character) hash of the InChI string. Used as a compact, web-searchable identifier. Format: XXXXXXXXXXXXXX-XXXXXXXXXX-X" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:institution a owl:ObjectProperty ;
    rdfs:label "institution" ;
    skos:definition "Contact's institution" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:institution_id a owl:DatatypeProperty ;
    rdfs:label "institution_id" ;
    skos:definition "Unique institution id" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:laboratory a owl:DatatypeProperty ;
    rdfs:label "laboratory" ;
    skos:definition "Name of the laboratory performing the analysis" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:land_use a owl:ObjectProperty ;
    rdfs:label "land_use" ;
    rdfs:seeAlso <https://www.w3.org/2015/03/corine> ;
    skos:definition "Land use classification according to CORINE Land Cover nomenclature." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:legislation_policy a owl:DatatypeProperty ;
    rdfs:label "legislation_policy" ;
    skos:definition "Link(s) to policy, convention, or legislation underpinning the monitoring activity. Mandatory for monitoring programmes; optional for projects if relevant. " ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:license a owl:DatatypeProperty ;
    rdfs:label "license" ;
    skos:definition "License or terms for data reuse." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:life_stage_age a owl:DatatypeProperty ;
    rdfs:label "life_stage_age" ;
    skos:definition "Life stage or age of the organism" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:managing_instance a owl:ObjectProperty ;
    rdfs:label "managing_instance" ;
    skos:definition "The institution that manages the sampling site" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:norman_id a owl:DatatypeProperty ;
    rdfs:label "norman_id" ;
    skos:definition "NORMAN substance identifier. Source: NORMAN EMPODAT / SusDat database." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:orcid a owl:DatatypeProperty ;
    rdfs:label "orcid" ;
    rdfs:range xsd:string ;
    skos:definition "ORCID identifier of the contact person" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:parameter a owl:ObjectProperty ;
    rdfs:label "parameter" ;
    skos:definition "Name of the parameter measured. Refer to the codelist-parameter tab for the list." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:provenance a owl:DatatypeProperty ;
    rdfs:label "provenance" ;
    skos:definition "A statement about the lineage of the dataset." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:pubchem_cid a owl:DatatypeProperty ;
    rdfs:label "pubchem_cid" ;
    skos:definition "PubChem Compound ID (CID). To be populated by mapping from InChIKey to PubChem." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:publication_year a owl:DatatypeProperty ;
    rdfs:label "publication_year" ;
    skos:definition "Year when the dataset was or will be made publicly available." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:river_basin a owl:ObjectProperty ;
    rdfs:label "river_basin" ;
    rdfs:seeAlso <https://www.eea.europa.eu/en/datahub/datahubitem-view/dc1b1cdf-5fa0-4535-8c89-10cc051e00db> ;
    skos:definition "River basin associated with the site, based on the EEA river basin districts dataset. Only relevant for water and sediment sampling." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    skos:definition "Role/function performed by the contact person. Source: ISO 19115:2003/19139 and EC Regulation No 1205/2008 (INSPIRE)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:ror a owl:DatatypeProperty ;
    rdfs:label "ror" ;
    rdfs:range xsd:string ;
    skos:definition "ROR identifier of the institution (format ror.org/xxxxxxxx)" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:sample_preparation_method a owl:DatatypeProperty ;
    rdfs:label "sample_preparation_method" ;
    skos:definition "Description of the process from sample collection to chemical analysis (e.g., extraction, cleanup, fractionation)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:sample_preparation_method_link a owl:DatatypeProperty ;
    rdfs:label "sample_preparation_method_link" ;
    skos:definition "GUPRI (e.g. DOI) linking to a public SOP, article, or other document describing the method." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:sampling_time_end a owl:DatatypeProperty ;
    rdfs:label "sampling_time_end" ;
    rdfs:range xsd:time ;
    skos:definition "Sampling end time according to ISO 8601." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:sampling_time_start a owl:DatatypeProperty ;
    rdfs:label "sampling_time_start" ;
    rdfs:range xsd:time ;
    skos:definition "Sampling start time according to ISO 8601, 24-hour clock. Format T[hh][mm][ss]." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:sea a owl:ObjectProperty ;
    rdfs:label "sea" ;
    rdfs:seeAlso <https://www.marineregions.org> ;
    skos:definition "Sea or ocean associated with the site, based on the Marine Regions Gazetteer. Only relevant for water and sediment sampling." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:site_description a owl:DatatypeProperty ;
    rdfs:label "site_description" ;
    skos:definition "Description of the site where samples were collected. Provide all important information that cannot be captured in other fields." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:soil_type a owl:ObjectProperty ;
    rdfs:label "soil_type" ;
    rdfs:seeAlso <https://inspire.ec.europa.eu/codelist/WRBReferenceSoilGroupValue> ;
    skos:definition "World Reference Base for Soil Resources (WRB) 2006/2007 Reference Soil Group at the site. Only relevant for soil sampling." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:taxon_id a owl:DatatypeProperty ;
    rdfs:label "taxon_id" ;
    rdfs:seeAlso <https://www.gbif.org/species/search> ;
    skos:definition "GBIF species key (integer). Resolves to https://www.gbif.org/species/{taxon_id}" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:taxon_name a owl:DatatypeProperty ;
    rdfs:label "taxon_name" ;
    rdfs:seeAlso <https://www.gbif.org/species/search> ;
    skos:definition "Scientific name of the taxon (genus, species or higher rank) as accepted in the GBIF Backbone Taxonomy." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:taxon_rank a owl:ObjectProperty ;
    rdfs:label "taxon_rank" ;
    rdfs:seeAlso <https://www.gbif.org/developer/species#rank> ;
    skos:definition "Taxonomic rank of the identified taxon." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:taxonomic_classification a owl:ObjectProperty ;
    rdfs:label "taxonomic_classification" ;
    skos:definition "A taxonomic entity identified in a biological sample, referenced against the GBIF Backbone Taxonomy." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:uncertainty a owl:DatatypeProperty ;
    rdfs:label "uncertainty" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:double [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Measurement uncertainty of the concentration/paramter value, expressed as a percentage (%) at 95% confidence level.  " ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    rdfs:range cenvo:Unit ;
    skos:definition "Unit of measurement" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "Version of the dataset." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:water_geographical_feature a owl:ObjectProperty ;
    rdfs:label "water_geographical_feature" ;
    skos:definition "Geographical water feature type at the site. Only relevant for water and sediment sampling." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:water_treatment a owl:ObjectProperty ;
    rdfs:label "water_treatment" ;
    skos:definition "Water treatment status at the site. Only relevant for water and sediment sampling." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:water_type a owl:ObjectProperty ;
    rdfs:label "water_type" ;
    skos:definition "Type of water body at the site. Only relevant for water and sediment sampling." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:wp9_id a owl:DatatypeProperty ;
    rdfs:label "wp9_id" ;
    skos:definition "Internal PARC WP9 identifier for the compound. Unique within the PARC compound list." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:year_established a owl:DatatypeProperty ;
    rdfs:label "year_established" ;
    skos:definition "Year of establishment of the monitoring station (YYYY)" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:EnvironmentalCompartment a owl:Class ;
    rdfs:label "EnvironmentalCompartment" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/EnvironmentalCompartment#Atmospheric> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/EnvironmentalCompartment#Aquatic> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/EnvironmentalCompartment#Terrestrial> ) ;
    skos:definition "Environmental compartment where a biota organism was sampled from. Excludes Biota since an organism cannot have Biota as its habitat." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/EnvironmentalCompartment#Aquatic>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/EnvironmentalCompartment#Atmospheric>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/EnvironmentalCompartment#Terrestrial> .

cenvo:MatrixAquatic a owl:Class ;
    rdfs:label "MatrixAquatic" ;
    rdfs:seeAlso <https://w3id.org/peh/terms/AquaticMatrix> ;
    owl:unionOf ( <https://w3id.org/peh/matrices/WaterTotal> <https://w3id.org/peh/matrices/PassiveWaterSamplerFraction> <https://w3id.org/peh/matrices/SedimentTotal> ) ;
    skos:definition "Matrix values valid for aquatic samples (SampleAquatic). All terms are narrower than AquaticMatrix in the PARC environmental matrix vocabulary." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/peh/matrices/PassiveWaterSamplerFraction>,
        <https://w3id.org/peh/matrices/SedimentTotal>,
        <https://w3id.org/peh/matrices/WaterTotal> .

cenvo:MeasurementConcentration a owl:Class ;
    rdfs:label "MeasurementConcentration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cenvo:analytical_method_link ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:data_handling_procedure ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:laboratory ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:analysis_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:data_handling_procedure_link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:data_handling_procedure_link ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty cenvo:loq ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sample_preparation_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty cenvo:lod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:analytical_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:compound ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:batch ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sample_preparation_method_link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:lod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:loq ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cenvo:analysis_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:analytical_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:data_handling_procedure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:analytical_method_link ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:laboratory ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:data_handling_procedure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:compound ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:lod ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:ChemicalCompound ;
            owl:onProperty cenvo:compound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:analysis_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:sample_preparation_method_link ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:batch ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:sample_preparation_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:batch ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:AnalyticalMethod ;
            owl:onProperty cenvo:analytical_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:loq ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:sample_preparation_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:laboratory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:analytical_method_link ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cenvo:sample_preparation_method_link ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cenvo:data_handling_procedure_link ],
        cenvo:Observation ;
    skos:definition "A measured concentration of a chemical compound in a sample. At least one of concentration, LOQ, or LOD must be provided." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:coordinate_privacy_exception_reason a owl:DatatypeProperty ;
    rdfs:label "coordinate_privacy_exception_reason" ;
    skos:definition "Justification for not providing coordinates. Required when coordinate_privacy_exception is true. Provide a brief explanation of the privacy, security or confidentiality reason that prevents disclosure of the exact site location." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:geographic_region a owl:ObjectProperty ;
    rdfs:label "geographic_region" ;
    skos:definition "UN M49 geographic region" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    skos:definition "Latitude in signed decimal degrees (format 0.000000, range -90 to 90). South latitude with minus sign. Coordinate reference system: WGS 84 (EPSG:4326). Mandatory unless coordinate_privacy_exception is true." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:lod a owl:DatatypeProperty ;
    rdfs:label "lod" ;
    skos:definition "Limit of detection" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    skos:definition "Longitude in signed decimal degrees (format 0.000000, range -180 to 180). West longitude with minus sign. Coordinate reference system: WGS 84 (EPSG:4326). Mandatory unless coordinate_privacy_exception is true." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:loq a owl:DatatypeProperty ;
    rdfs:label "loq" ;
    skos:definition "Limit of quantification" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:monitoring_reasons a owl:DatatypeProperty ;
    rdfs:label "monitoring_reasons" ;
    skos:definition "Primary reasons for performing monitoring (e.g. regulatory requirements). Mandatory for monitoring programmes; optional for projects if relevant." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:nuts3 a owl:DatatypeProperty ;
    rdfs:label "nuts3" ;
    rdfs:seeAlso <http://data.europa.eu/nuts/> ;
    skos:definition "NUTS3 region code according to the Eurostat NUTS classification (Nomenclature of Territorial Units for Statistics), level 3. Example: CZ080 (Moravskoslezsky kraj), DE300 (Berlin). If NUTS3 is not applicable (e.g. non-EU countries), use an alternative administrative classification." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:regional_group a owl:ObjectProperty ;
    rdfs:label "regional_group" ;
    skos:definition "Regional group of United Nations member states" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Domain a owl:Class ;
    rdfs:label "Domain" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Atmospheric> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Aquatic> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Terrestrial> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Biota> ) ;
    skos:definition "Environmental domain - sample type according to sampled matrix/ environmental compartment. " ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Aquatic>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Atmospheric>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Biota>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Domain#Terrestrial> .

cenvo:ImplementationLevel a owl:Class ;
    rdfs:label "ImplementationLevel" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#international> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#national> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#regional> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#local> ) ;
    skos:definition "The geographic scale of the monitoring coverage  (e.g. international, national, regional, or local)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#international>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#local>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#national>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/ImplementationLevel#regional> .

cenvo:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cenvo:ObservationType ;
            owl:onProperty cenvo:observation_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:observation_type ],
        [ owl:unionOf ( cenvo:MeasurementConcentration cenvo:MeasurementParameter ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:uncertainty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:double [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty cenvo:uncertainty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:observation_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:uncertainty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:sample_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Unit ;
            owl:onProperty cenvo:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty cenvo:value ] ;
    skos:definition "Abstract base class for all observations associated with a sample. Every observation must be either a MeasurementConcentration or a MeasurementParameter. Contains shared slots (unit, uncertainty, value) common to all observation types." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:coordinate_privacy_exception a owl:DatatypeProperty ;
    rdfs:label "coordinate_privacy_exception" ;
    skos:definition "Set to true (value = true) if coordinates cannot be provided for privacy, security or confidentiality reasons. If true, expert location fields (country, geographic_region, nuts3) are required instead.  Optional - if not provided, it is assumed coordinates are not withheld for privacy reasons." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:type a owl:ObjectProperty ;
    rdfs:label "type" ;
    skos:definition "Type of monitoring activity" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:double ;
    skos:definition "Measured value of the chemical concentration or other parameter" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Gender a owl:Class ;
    rdfs:label "Gender" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#male> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#female> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#hermaphrodite> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#not_specified> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#not_relevant> ) ;
    skos:definition "Biological sex of a sampled organism" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#female>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#hermaphrodite>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#male>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#not_relevant>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/Gender#not_specified> .

cenvo:GeographicRegion a owl:Class ;
    rdfs:label "GeographicRegion" ;
    rdfs:seeAlso <https://unstats.un.org/unsd/methodology/m49/> ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Africa> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Americas> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Asia> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Europe> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Oceania> ) ;
    skos:definition "UN M49 geographic region. Source: https://unstats.un.org/unsd/methodology/m49/" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Africa>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Americas>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Asia>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Europe>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/GeographicRegion#Oceania> .

cenvo:UNRegionalGroup a owl:Class ;
    rdfs:label "UNRegionalGroup" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#african> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#asia_pacific> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#eastern_european> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#grulac> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#weog> ) ;
    skos:definition "Regional groups of United Nations member states" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#african>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#asia_pacific>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#eastern_european>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#grulac>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/UNRegionalGroup#weog> .

cenvo:country a owl:ObjectProperty ;
    rdfs:label "country" ;
    rdfs:range cenvo:Country ;
    skos:definition "Country where the site, institution or project is located, according to ISO 3166-1 alpha-2 (two-letter uppercase code)." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:link a owl:DatatypeProperty ;
    rdfs:label "link" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL with information about the institution" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:name_original a owl:DatatypeProperty ;
    rdfs:label "name_original" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the entity in the original language of the  institution/site/project. Use the local official name." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:observation_type a owl:ObjectProperty ;
    rdfs:label "observation_type" ;
    skos:definition "Type of measurement/observation: i) Chemical concentration in the environment or biota - main observation and; ii) Other parameters - they give context to the main measurement." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:sample_id a owl:DatatypeProperty ;
    rdfs:label "sample_id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier for the sample" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:site_id a owl:DatatypeProperty ;
    rdfs:label "site_id" ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier of the monitoring site where the sample was collected. References the site_id of a Site record." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:site_name a owl:DatatypeProperty ;
    rdfs:label "site_name" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the monitoring site. Provide in the local language as the primary name. An English name may be added if available and commonly used. Multiple names in different languages are accepted." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:Sample a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:site_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:observations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:sample_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:site_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:site_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sampling_time_start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cenvo:end_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sample_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cenvo:domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty cenvo:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:site_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Observation ;
            owl:onProperty cenvo:observations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:time ;
            owl:onProperty cenvo:sampling_time_start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:sampling_time_end ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cenvo:site_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:time ;
            owl:onProperty cenvo:sampling_time_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cenvo:site_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:sampling_time_start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cenvo:sampling_time_end ],
        [ owl:unionOf ( cenvo:Aquatic cenvo:Atmospheric cenvo:Biota cenvo:Terrestrial ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom cenvo:Domain ;
            owl:onProperty cenvo:domain ] ;
    skos:definition "Abstract base class for all sample types" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:domain a owl:ObjectProperty ;
    rdfs:label "domain" ;
    skos:definition "Sample type according to sampled matrix:  Atmospheric for air, particles, precipitation, dust; Aquatic for water and sediment; Terrestrial for soil Biota for plants and animals" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

xsd:anyURI a rdfs:Datatype .

cenvo:end_date a owl:DatatypeProperty ;
    rdfs:label "end_date" ;
    rdfs:range xsd:date ;
    skos:definition "End date in format YYYY-MM-DD",
        "End date of the project/monitoring programme." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:name_en a owl:DatatypeProperty ;
    rdfs:label "name_en" ;
    rdfs:range xsd:string ;
    skos:definition "Name or designation in English" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:start_date a owl:DatatypeProperty ;
    rdfs:label "start_date" ;
    rdfs:range xsd:date ;
    skos:definition "Start date in format YYYY-MM-DD",
        "The beginning (or previewed starting) date of the monitoring programme/project." ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> .

cenvo:AquaticMatrixFraction a owl:Class ;
    rdfs:label "AquaticMatrixFraction" ;
    owl:unionOf ( <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#PLACEHOLDER> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_spm> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_dom> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_cfree> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_dom%2Bcfree> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_colloidal_fraction> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#sediment_solid_phase> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#sediment_pore_water> <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#sediment_colloidal_fraction> ) ;
    skos:definition "TBC - might be integrated with the matrix vocabulary" ;
    skos:inScheme <https://w3id.org/chemical-exposome/schema/chemicals-outdoor> ;
    linkml:permissible_values <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#PLACEHOLDER>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#sediment_colloidal_fraction>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#sediment_pore_water>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#sediment_solid_phase>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_cfree>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_colloidal_fraction>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_dom>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_dom%2Bcfree>,
        <https://w3id.org/chemical-exposome/schema/chemicals-outdoor/AquaticMatrixFraction#water_spm> .

cenvo:MatrixTerrestrial a owl:Class ;
    rdfs:label "MatrixTerrestrial" ;
    rdfs:seeAlso <https://w3id.org/peh/terms/TerrestrialMatrix> ;
